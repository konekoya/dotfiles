#!/bin/bash
# Description: List, inspect and merge pull requests or open the current PR

set -euo pipefail

# Resolve this script's real location so installed symlinks use their own checkout.
SOURCE_PATH="$0"
case "$SOURCE_PATH" in
  /*) ;;
  *) SOURCE_PATH="$PWD/$SOURCE_PATH" ;;
esac
while [ -L "$SOURCE_PATH" ]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
  LINK_TARGET="$(readlink "$SOURCE_PATH")"
  case "$LINK_TARGET" in
    /*) SOURCE_PATH="$LINK_TARGET" ;;
    *) SOURCE_PATH="$SOURCE_DIR/$LINK_TARGET" ;;
  esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
PR_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"

usage() {
  cat <<'EOF'
Usage: pr <command> [options]

Commands:
  list                         List active Azure DevOps PRs
  status [ID] [options]        Show CI/build status for a PR
  comments [ID]                Show comment threads for a PR
  merge [ID] [options]         Preview a squash merge; --execute performs it
  open                         Open the current PR or repository page

Run 'pr <command> --help' for command options.
EOF
}

unsupported_github() {
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && ado_resolve_remote_context && [ "$ADO_REMOTE_PROVIDER" = github ]; then
    echo "❌ Selected Git remote is not a recognized Azure DevOps remote. This pr subcommand is unsupported for GitHub remotes.${1:+ $1}" >&2
    exit 1
  fi
}

COMMAND="${1:-list}"
if [ "$#" -gt 0 ]; then
  shift
fi

case "$COMMAND" in
  --help|-h)
    usage
    exit 0
    ;;
  list)
    if [ "$#" -gt 0 ]; then
      case "$1" in
        --help|-h) usage; exit 0 ;;
        *) echo "Usage: pr list" >&2; exit 2 ;;
      esac
    fi
    source "$PR_ROOT/lib/azure-devops.sh"
    unsupported_github
    source "$PR_ROOT/lib/pr-list.sh"
    ;;
  status)
    case " $* " in
      *" --help "*|*" -h "*)
        cat <<'EOF'
Usage: pr status [ID] [--watch] [--interval SECONDS] [--json]
Show CI/build policy status for the current branch's PR or the specified PR.
EOF
        exit 0
        ;;
    esac
    case " $* " in
      *" --json "*" --watch "*|*" --watch "*" --json "*)
        echo "❌ --json cannot be combined with --watch." >&2
        exit 2
        ;;
    esac
    source "$PR_ROOT/lib/azure-devops.sh"
    unsupported_github
    source "$PR_ROOT/lib/pr-status.sh"
    ;;
  comments)
    case " $* " in
      *" --help "*|*" -h "*)
        cat <<'EOF'
Usage: pr comments [ID]
Fetch and display comment threads for the current branch's PR or the specified PR.
EOF
        exit 0
        ;;
    esac
    source "$PR_ROOT/lib/azure-devops.sh"
    unsupported_github
    source "$PR_ROOT/lib/pr-comments.sh"
    ;;
  merge)
    case " $* " in
      *" --help "*|*" -h "*)
        cat <<'EOF'
Usage: pr merge [ID] [--json] [--waive-checklist]
       pr merge ID --requeue-expired
       pr merge ID --execute --head SHA [--waive-checklist] [--interval SECONDS] [--timeout SECONDS] [--json]

Default: read-only preview of whether the PR can be squash-merged (sends no write).
  --json              Preview (or --execute result) as one JSON object.
  --execute           Squash-merge the PR, pinned to --head; never bypasses policy.
  --head SHA          Source head shown by the preview (8-40 hex characters); required with --execute.
  --waive-checklist   Owner's decision only: do not block on unticked or stale checklist items.
                      Never ticks or edits a box. Other block reasons still apply.
  --requeue-expired   Requeue expired build policy evaluations only; cannot be combined with --execute.
  --interval, --timeout   Completion polling after --execute (default 5s, 300s).
Azure DevOps only; GitHub remotes: use the merge-pr skill.
EOF
        exit 0
        ;;
    esac
    source "$PR_ROOT/lib/azure-devops.sh"
    unsupported_github "Use the merge-pr skill to merge GitHub pull requests."
    source "$PR_ROOT/lib/pr-merge.sh"
    ;;
  open)
    case " $* " in
      *" --help "*|*" -h "*)
        cat <<'EOF'
Usage: pr open
Open the current branch's PR, or the repository page if no PR is found.
EOF
        exit 0
        ;;
    esac
    if [ "$#" -gt 0 ]; then
      echo "Usage: pr open" >&2
      exit 2
    fi
    source "$PR_ROOT/lib/pr-open.sh"
    ;;
  *)
    echo "❌ Unknown pr command: $COMMAND" >&2
    usage >&2
    exit 2
    ;;
esac
