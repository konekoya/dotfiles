#!/bin/bash
# Description: Interactive menu to browse and run scripts in the scripts directory

usage() {
  printf '%s\n' 'Usage: cmds [--list | --json | --help]' \
    '  With no arguments, browse and run scripts interactively.' \
    '  --list  List command names and descriptions.' \
    '  --json  List commands as a JSON array.'
}

mode=interactive
if (( $# > 0 )); then
  if (( $# != 1 )); then usage >&2; exit 2; fi
  case "$1" in
    --list) mode=list ;;
    --json) mode=json ;;
    --help|-h) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
fi

SCRIPTS_DIR="$(dirname "$(realpath "$0")")"
export LC_ALL=C

# ── collect scripts ──────────────────────────────────────────────────────────
declare -a scripts names descs
max_name_len=0

for f in "$SCRIPTS_DIR"/*; do
  [[ -f "$f" && -x "$f" && -r "$f" ]] || continue
  name="${f##*/}"
  [[ "$name" == "cmds" && "$mode" == interactive ]] && continue

  # Only the designated metadata line is safe to display; never scan script bodies.
  desc=""
  { IFS= read -r _ || :; IFS= read -r desc || :; } < "$f"
  case "$desc" in '# Description: '*) desc="${desc#\# Description: }" ;; *) desc="" ;; esac
  [[ -z "$desc" || "$desc" == *[[:cntrl:]]* ]] && desc="(no description)"
  # Control characters would make the plain-text listing ambiguous.
  [[ "$name" == *[[:cntrl:]]* ]] && continue

  scripts+=("$f")
  names+=("$name")
  descs+=("$desc")

  (( ${#name} > max_name_len )) && max_name_len=${#name}
done

json_string() {
  local value="$1" char i
  printf '"'
  for (( i=0; i<${#value}; i++ )); do
    char="${value:i:1}"
    case "$char" in
      '"') printf '\\"' ;;
      '\') printf '\\\\' ;;
      *) printf '%s' "$char" ;;
    esac
  done
  printf '"'
}

if [[ "$mode" == list ]]; then
  for i in "${!names[@]}"; do printf '%s\t%s\n' "${names[$i]}" "${descs[$i]}"; done
  exit 0
elif [[ "$mode" == json ]]; then
  printf '['
  separator=""
  for i in "${!names[@]}"; do
    printf '%s{"name":' "$separator"
    json_string "${names[$i]}"
    printf ',"description":'
    json_string "${descs[$i]}"
    printf '}'
    separator=,
  done
  printf ']\n'
  exit 0
fi

if [[ ${#scripts[@]} -eq 0 ]]; then
  echo "No scripts found in $SCRIPTS_DIR"
  exit 0
fi

# ── fzf fast path (optional) ─────────────────────────────────────────────────
if command -v fzf &>/dev/null; then
  input=""
  for i in "${!names[@]}"; do
    input+="$(printf "%-*s  %s" "$max_name_len" "${names[$i]}" "${descs[$i]}")"$'\n'
  done
  selected_name="$(printf '%s' "$input" | fzf \
    --prompt='> ' \
    --height=~50% \
    --layout=reverse \
    --border \
    --header='Select a script to run  (Esc to quit)' \
    | awk '{print $1}')"
  [[ -z "$selected_name" ]] && exit 0
  exec "$SCRIPTS_DIR/$selected_name"
fi

# ── pure bash interactive menu ───────────────────────────────────────────────
RESET=$'\033[0m'
BOLD=$'\033[1m'
DIM=$'\033[2m'
REVERSE=$'\033[7m'

cursor=0
first_draw=true
line_count=0
col_width=$(( max_name_len + 2 ))

draw_menu() {
  local lines=0
  if [[ $first_draw == false ]]; then
    printf "\033[%dA" "$line_count"
  fi
  first_draw=false

  printf "%s  Scripts%s\n" "$BOLD" "$RESET"
  (( lines++ ))

  for i in "${!names[@]}"; do
    if (( i == cursor )); then
      printf "%s  %-*s  %s%s\n" "$REVERSE" "$col_width" "${names[$i]}" "${descs[$i]}" "$RESET"
    else
      printf "  %-*s  %s\n" "$col_width" "${names[$i]}" "${DIM}${descs[$i]}${RESET}"
    fi
    (( lines++ ))
  done

  printf "\n%s  ↑↓ navigate  Enter run  q quit%s\n" "$DIM" "$RESET"
  (( lines += 2 ))

  line_count=$lines
}

_KEY=""
read_key() {
  local key status
  _KEY=""
  # A bounded read lets Bash handle a pending TERM trap while waiting for input.
  while true; do
    if IFS= read -rs -n1 -t 1 key; then
      break
    else
      status=$?
    fi
    if (( status <= 128 )); then
      _KEY="QUIT"
      return
    fi
  done
  if [[ "$key" == $'\033' ]]; then
    IFS= read -rs -n2 -t 1 key
    case "$key" in
      '[A') _KEY="UP"    ;;
      '[B') _KEY="DOWN"  ;;
      *)    _KEY="ESC"   ;;
    esac
  elif [[ "$key" == "" ]]; then
    _KEY="ENTER"
  elif [[ "$key" =~ ^[qQ]$ ]]; then
    _KEY="QUIT"
  fi
}

# ── terminal setup ────────────────────────────────────────────────────────────
saved_stty="$(stty -g)" || exit 1
cleanup() {
  tput cnorm
  stty "$saved_stty"
  echo
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

stty -echo
tput civis

# ── main loop ─────────────────────────────────────────────────────────────────
selected=-1
while true; do
  draw_menu
  read_key
  case "$_KEY" in
    UP)    (( cursor > 0 )) && (( cursor-- ))                        ;;
    DOWN)  (( cursor < ${#scripts[@]} - 1 )) && (( cursor++ ))       ;;
    ENTER) selected=$cursor; break                                    ;;
    QUIT|ESC) break                                                   ;;
  esac
done

if (( selected >= 0 )); then
  cleanup
  trap - EXIT INT TERM
  exec "${scripts[$selected]}"
fi
exit 0
