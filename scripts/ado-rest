#!/bin/bash
# Description: Make a repository-scoped Azure DevOps REST request with its selected profile

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
source "$SCRIPT_DIR/../lib/azure-devops.sh"
source "$SCRIPT_DIR/../lib/http.sh"
source "$SCRIPT_DIR/../lib/local-env.sh"

print_usage() {
  cat <<'USAGE'
Usage: ado-rest context | GET|POST|PATCH|PUT|DELETE /_apis/... [JSON_BODY|-|@FILE]

POST, PATCH and PUT require a JSON body; DELETE may omit it. Give the body as the
third argument, '-' to read it from stdin, or '@FILE' to read it from a file (like
curl -d). Build JSON with jq -n so quotes and newlines are escaped.

Example (add a comment to a pull request thread):
  body="$(jq -n --arg text 'Thanks, fixed.' '{content: $text, commentType: "text"}')"
  ado-rest POST '/_apis/git/repositories/<repository>/pullrequests/<id>/threads/<thread>/comments?api-version=7.1' "$body"

The same body from stdin or a file:
  jq -n --arg text 'Thanks, fixed.' '{content: $text, commentType: "text"}' | ado-rest POST '/_apis/...' -
  ado-rest POST '/_apis/...' @body.json
USAGE
}

usage() {
  print_usage >&2
}

# Report a request or body problem with the usage and a write example, so the failure explains itself.
body_error() {
  echo "❌ $1" >&2
  usage
  exit 2
}

for arg in "$@"; do
  case "$arg" in
    -h|--help) print_usage; exit 0 ;;
  esac
done

if [ "$#" -lt 1 ] || [ "$#" -gt 3 ]; then
  usage
  exit 2
fi

for cmd in jq curl; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "❌ '$cmd' is required. Install with: brew install $cmd" >&2
    exit 1
  fi
done

if [ "$1" = context ]; then
  [ "$#" -eq 1 ] || { usage; exit 2; }
  method=context
else
  [ "$#" -ge 2 ] || { usage; exit 2; }
  method="$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')"
  api_path="$2"
  body="${3-}"
  case "$method" in
    GET|POST|PATCH|PUT|DELETE) ;;
    *) usage; exit 2 ;;
  esac
  case "$api_path" in
    /_apis/*) ;;
    *) echo "❌ Azure DevOps API paths must start with '/_apis/'." >&2; exit 2 ;;
  esac
  case "$api_path" in
    *" "*|*\\*|*\#*|*$'\t'*|*$'\r'*|*$'\n'*|*://*|*/../*|*/..|*/./*)
      echo "❌ Azure DevOps API path contains unsupported characters." >&2
      exit 2
      ;;
  esac
  lower_path="$(printf '%s' "$api_path" | tr '[:upper:]' '[:lower:]')"
  case "$lower_path" in
    *token=*|*key=*|*secret=*|*password=*|*authorization=*|*pat=*|*credential=*)
      echo "❌ Credentials are not allowed in Azure DevOps API paths." >&2
      exit 2
      ;;
  esac
  body_source="argument"
  if [ "$method" = GET ] && [ "$#" -eq 3 ]; then
    body_error "GET requests do not accept a body."
  fi
  if [ "$#" -eq 3 ]; then
    case "$body" in
      -|@-)
        if [ -t 0 ]; then
          body_error "${method} body '-' reads stdin, but stdin is a terminal. Pipe the JSON in."
        fi
        body_source="stdin"
        body="$(cat)" || body_error "Could not read the ${method} request body from stdin."
        ;;
      @*)
        body_file="${body#@}"
        if [ -z "$body_file" ] || [ ! -f "$body_file" ] || [ ! -r "$body_file" ]; then
          body_error "${method} body file is missing or unreadable."
        fi
        body_source="file"
        body="$(cat "$body_file")" || body_error "Could not read the ${method} request body file."
        ;;
    esac
  fi
  if { [ "$method" = POST ] || [ "$method" = PATCH ] || [ "$method" = PUT ]; } && [ "$#" -ne 3 ]; then
    body_error "${method} requests require a JSON body argument ('-' for stdin, '@FILE' for a file)."
  fi
  if { [ "$method" = POST ] || [ "$method" = PATCH ] || [ "$method" = PUT ] || [ "$method" = DELETE ]; } \
    && [ "$#" -eq 3 ] && ! printf '%s' "$body" | jq -e . >/dev/null 2>&1; then
    body_error "${method} request body must be valid JSON (read from ${body_source})."
  fi
fi

if ! ado_resolve_repo_context; then
  echo "❌ ${ADO_CONTEXT_ERROR}" >&2
  exit 1
fi
if ! ado_get_auth_header; then
  echo "❌ ${ADO_AUTH_ERROR}" >&2
  exit 1
fi

if [ "$method" = context ]; then
  jq -n \
    --arg organization "$ADO_ORG" \
    --arg project "$ADO_PROJECT" \
    --arg repository "$ADO_REPO" \
    --arg remote "$ADO_REMOTE_NAME" \
    '{organization: $organization, project: $project, repository: $repository, remote: $remote}'
  exit 0
fi

url="https://dev.azure.com/${ADO_ORG}/${ADO_PROJECT}${api_path}"
if [ "$method" = GET ]; then
  response="$(http_request -H "$ADO_AUTH_HEADER" "$url")" || exit 1
elif [ "$method" = DELETE ] && [ "$#" -eq 2 ]; then
  response="$(http_request -X DELETE -H "$ADO_AUTH_HEADER" "$url")" || exit 1
else
  # Work item updates and creations (POST to .../workitems/$<Type>) are JSON Patch documents
  # and are rejected with HTTP 400 as application/json.
  content_type="application/json"
  case "$lower_path" in
    /_apis/wit/workitems/\$*) [ "$method" = POST ] || [ "$method" = PATCH ] && content_type="application/json-patch+json" ;;
    /_apis/wit/workitems/*) [ "$method" = PATCH ] && content_type="application/json-patch+json" ;;
  esac
  response="$(http_request -X "$method" \
    -H "$ADO_AUTH_HEADER" \
    -H "Content-Type: $content_type" \
    "$url" \
    -d "$body")" || exit 1
fi

# Azure DevOps DELETE operations may return HTTP 204 with an empty response body.
if [ -z "$response" ]; then
  exit 0
fi
if ! printf '%s' "$response" | jq -e . >/dev/null 2>&1; then
  echo "❌ API request returned invalid JSON." >&2
  exit 1
fi
printf '%s\n' "$response"
