# Shared zsh configuration, sourced from ~/.zshrc by install.sh.
# Per-machine overrides belong in zsh/.zshrc.local (not tracked), which is
# loaded first so it can set ZSH_THEME, DOTFILES_EXTRA_PLUGINS, STARSHIP_CONFIG, etc.
# Every tool is guarded so a laptop without it still gets a working shell.

DOTFILES_ZSH_DIR="${${(%):-%x}:A:h}"

[ -f "$DOTFILES_ZSH_DIR/.zshrc.local" ] && source "$DOTFILES_ZSH_DIR/.zshrc.local"

# oh-my-zsh: theme is only a fallback prompt when starship is missing.
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
ZSH_THEME="${ZSH_THEME:-robbyrussell}"

# Preserve the list that an earlier ~/.zshrc may already have loaded. Updating
# `plugins` after oh-my-zsh has run does not load any additional plugins.
typeset -a _dotfiles_omz_plugins_before_shared=("${plugins[@]}")
_dotfiles_omz_preloaded=false
(( $+functions[omz] )) && _dotfiles_omz_preloaded=true

# Syntax highlighting is sourced at the end of this file so it can wrap widgets
# created by the other plugins and shell integrations.
plugins=(git zsh-autosuggestions "${DOTFILES_EXTRA_PLUGINS[@]}")

# Skip when oh-my-zsh is missing or an earlier ~/.zshrc line already loaded it.
if [ -f "$ZSH/oh-my-zsh.sh" ] && (( ! $+functions[omz] )); then
  source "$ZSH/oh-my-zsh.sh"
fi

set -o vi
# Without this, Esc waits 0.4s before leaving insert mode. 1 = 10ms, which still
# lets terminal escape sequences (arrow keys) arrive intact.
KEYTIMEOUT=1

# If ~/.zshrc loaded oh-my-zsh before this shared file, load its configured
# plugins directly. This keeps existing user files intact while still applying
# the shared plugin settings.
if [[ "$_dotfiles_omz_preloaded" == true ]]; then
  _dotfiles_zsh_custom_plugins="${ZSH_CUSTOM:-$ZSH/custom}/plugins"

  if (( ! $+functions[_zsh_autosuggest_start] )); then
    _dotfiles_plugin_file="$_dotfiles_zsh_custom_plugins/zsh-autosuggestions/zsh-autosuggestions.plugin.zsh"
    [ -f "$_dotfiles_plugin_file" ] && source "$_dotfiles_plugin_file"
  fi

  for _dotfiles_extra_plugin in "${DOTFILES_EXTRA_PLUGINS[@]}"; do
    (( ${_dotfiles_omz_plugins_before_shared[(Ie)$_dotfiles_extra_plugin]} )) && continue
    for _dotfiles_plugin_file in \
      "$_dotfiles_zsh_custom_plugins/$_dotfiles_extra_plugin/$_dotfiles_extra_plugin.plugin.zsh" \
      "$_dotfiles_zsh_custom_plugins/$_dotfiles_extra_plugin/$_dotfiles_extra_plugin.zsh" \
      "$ZSH/plugins/$_dotfiles_extra_plugin/$_dotfiles_extra_plugin.plugin.zsh" \
      "$ZSH/plugins/$_dotfiles_extra_plugin/$_dotfiles_extra_plugin.zsh"; do
      [ -f "$_dotfiles_plugin_file" ] || continue
      source "$_dotfiles_plugin_file"
      break
    done
  done
fi

# Azure CLI completion (Homebrew install). Login shells already export
# HOMEBREW_PREFIX via `brew shellenv`; only fall back to the slow `brew --prefix`
# subprocess when it is missing.
_dotfiles_brew_prefix="${HOMEBREW_PREFIX:-}"
if [[ -z "$_dotfiles_brew_prefix" ]] && command -v brew >/dev/null 2>&1; then
  _dotfiles_brew_prefix="$(brew --prefix 2>/dev/null)"
fi
if [[ -n "$_dotfiles_brew_prefix" && -f "$_dotfiles_brew_prefix/etc/bash_completion.d/az" ]]; then
  (( $+functions[compdef] )) || { autoload -Uz compinit && compinit; }
  autoload bashcompinit && bashcompinit
  source "$_dotfiles_brew_prefix/etc/bash_completion.d/az"
fi

# Prompt: must come after oh-my-zsh so starship replaces the theme prompt.
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# fzf key bindings (Ctrl-R history, Ctrl-T files, Alt-C directories) and fuzzy
# completion. `fzf --zsh` needs fzf 0.48+; older versions fail and are skipped.
# It binds the emacs, viins and vicmd keymaps, and runs before syntax
# highlighting so that plugin can wrap the widgets it creates. Skipped when stdin
# is not a terminal (for example `zsh -i -c ...` from a tool), where there is no
# line editor and the fzf script prints "can't change option: zle".
if [[ -t 0 ]] && command -v fzf >/dev/null 2>&1; then
  _dotfiles_fzf_init="$(fzf --zsh 2>/dev/null)" && [[ -n "$_dotfiles_fzf_init" ]] && eval "$_dotfiles_fzf_init"
fi

# This plugin must run after other plugins and shell integrations that may add
# ZLE widgets. A ~/.zshrc that already loaded it will have defined the function.
if (( ! $+functions[_zsh_highlight] )); then
  _dotfiles_plugin_file="${ZSH_CUSTOM:-$ZSH/custom}/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.plugin.zsh"
  [ -f "$_dotfiles_plugin_file" ] && source "$_dotfiles_plugin_file"
fi

unset _dotfiles_omz_plugins_before_shared _dotfiles_omz_preloaded
unset _dotfiles_zsh_custom_plugins _dotfiles_extra_plugin _dotfiles_plugin_file
unset _dotfiles_brew_prefix _dotfiles_fzf_init
unset DOTFILES_ZSH_DIR
