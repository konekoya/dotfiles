# Per-machine API tokens, secrets, and local configuration.
#
# install.sh copies this file to alias/.env on first run — that copy is gitignored,
# so local values never end up in git history. Uncomment and fill in what you need;
# anything left unset just means the matching integration is skipped.
#
# The interactive shell does NOT source this file, so these values are not exported to
# every program you start. Scripts load only the names they need, when they run
# (lib/local-env.sh), and agent skills do the same with
# `source "$(command -v local-env)" NAME`, which sets an unexported variable.
# A value already exported in your environment takes precedence over this file.
# Put exports that your shell itself needs in alias/.user_alias or zsh/.zshrc.local instead.

# ClickUp → Settings → Apps
# Required by: submit-pr, create-clickup-task (without it, ClickUp integration is skipped)
# export CLICKUP_API_TOKEN="pk_..."

# Azure DevOps REST credentials. Profile names are non-secret Git config; PATs stay here.
# Add a separate profile and PAT for each company or personal organization.
# A repository selects exactly one with:
#   git config --local azure-devops.profile work-company-a
# Profiles are not auto-selected from the remote organization.
# The selected profile's organization must match that repository's remote.
# Profile names start with a lowercase letter and use lowercase letters, digits,
# or hyphens. Underscores are not allowed. Hyphens become underscores in PAT names.
# export AZURE_DEVOPS_PAT_WORK_COMPANY_A="..."
# export AZURE_DEVOPS_PAT_WORK_COMPANY_B="..."
# export AZURE_DEVOPS_PAT_PERSONAL="..."

# Legacy single-organization setup. AZURE_DEVOPS_ORG must match the selected remote;
# it never overrides the organization in a repository URL.
# export AZURE_DEVOPS_ORG="my-org"
# export AZURE_DEVOPS_PAT="..."

# Optional default only for `pr` when run outside a Git repository. Configure the
# matching non-secret profile in ~/.gitconfig.local. Repository commands use the
# per-repository `azure-devops.profile` setting instead.
# export AZURE_DEVOPS_PROFILE="work-company-a"

# Azure CLI profiles are configured in ~/.gitconfig.local with auth=azure-cli,
# tenant, user, and object-id. No account or subscription is switched by scripts.

# GitHub token used by `repo` to look up the branch's PR. Without it `repo` uses `gh auth token`.
# export GITHUB_TOKEN="..."

# Work Git identity used by config-git (applied to the current repository only)
# export GIT_WORK_NAME="Your Name"
# export GIT_WORK_EMAIL="you@company.com"

# Optional private work-notes repository (SSH URL; never embed a token in the URL).
# install.sh clones it and links what its links.tsv lists; doctor checks links and sync state.
# export WORK_NOTES_REPO="git@github.com:<you>/work-notes.git"
# export WORK_NOTES_DIR="$HOME/work-notes"   # default
