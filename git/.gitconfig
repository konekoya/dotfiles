# This is Git's per-user configuration file.
[core]
	editor = vi
	pager = delta
	excludesfile = ~/.gitignore_global

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    # Theme is auto-detected from the terminal; set dark = true or light = true
    # in ~/.gitconfig.local to force one.
    side-by-side = true

[merge]
    conflictstyle = zdiff3

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[pull]
	rebase = true

[rebase]
	autoStash = true
	updateRefs = true

[rerere]
	enabled = true

[diff]
	algorithm = histogram
	colorMoved = default

[branch]
	sort = -committerdate

# Machine-local settings (identity). install.sh creates this file; keep it last so it wins.
[include]
	path = ~/.gitconfig.local
